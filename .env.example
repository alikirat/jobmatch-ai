# --- MongoDB ---
# Root credentials for the local `docker compose up` MongoDB instance.
MONGO_ROOT_USERNAME=jobmatch
MONGO_ROOT_PASSWORD=change-me

# Connection string the backend uses, must carry the same credentials as above.
MONGODB_URI=mongodb://jobmatch:change-me@localhost:27017/?authSource=admin
MONGODB_DATABASE=jobmatch

# --- Adzuna ---
# Job listings API credentials from https://developer.adzuna.com/
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# --- Gemini ---
# Used by google-adk's LlmAgent (via google-genai) for the scoring/gap-analysis/
# resume-optimizer nodes. google-genai reads GOOGLE_API_KEY first, falling back to
# GEMINI_API_KEY if both are set -- see agents/llm/client.py.
GOOGLE_API_KEY=your-gemini-api-key
