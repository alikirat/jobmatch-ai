# --- MongoDB ---
# Root credentials for the local `docker compose up` MongoDB instance.
MONGO_ROOT_USERNAME=jobmatch
MONGO_ROOT_PASSWORD=change-me

# Connection string the backend uses, must carry the same credentials as above.
MONGODB_URI=mongodb://jobmatch:change-me@localhost:27017/?authSource=admin
MONGODB_DATABASE=jobmatch

# --- Adzuna ---
# Job listings API credentials from https://developer.adzuna.com/
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
